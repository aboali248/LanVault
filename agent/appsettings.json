{
  "LanVaultAgent": {
    "Server": {
      "BaseUrl": "http://localhost:3031/api/v1/"
    },
    "HeartbeatIntervalSeconds": 30,
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentBackups": 1,
    "StateDirectory": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
